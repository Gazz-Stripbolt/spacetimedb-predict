<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1 so Unity (2021.2+) and Godot can use it. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>SpacetimeDB.Predict</RootNamespace>
    <PackageId>SpacetimeDB.Predict</PackageId>
    <Version>0.1.0</Version>
    <Description>Optimistic updates / client-side prediction for SpacetimeDB C# clients (Unity, Godot, .NET).</Description>
    <Authors>Tinker (Pogly)</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SpacetimeDB.ClientSDK" Version="2.14.*" />
  </ItemGroup>

</Project>
